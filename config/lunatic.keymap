// scroll

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 600

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>

//#include <interfaces/hid-trackball.dtsi>  //zmk-hid-trackball-interface

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Main 0
#define Num 1
#define Mouse 2
#define Opt1 3
#define Opt2 4

//#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
//#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <420>;
    acceleration-exponent = <1>;
    trigger-period-ms = <14>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0 8>;
        };

        select_to_bol {
            bindings = <&kp LS(HOME)>;
            key-positions = <30 31>;
            layers = <0>;
        };

        select_to_eol {
            bindings = <&kp RS(END)>;
            key-positions = <32 33>;
            layers = <0>;
        };

        word_backward {
            bindings = <&kp LC(LEFT)>;
            key-positions = <18 19>;
            layers = <0>;
        };

        word_forward {
            bindings = <&kp RC(RIGHT)>;
            key-positions = <20 21>;
            layers = <0>;
        };

        mousekey_3 {
            bindings = <&mkp MB3>;
            key-positions = <29 17>;
            layers = <2>;
        };

        esc-jk {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
            layers = <0>;
        };
    };

    macros {
        m0: m0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "M0";
        };

        m1: m1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_tap>,
                <&kp ESC>,
                <&macro_release>,
                <&kp LCTRL &kp LSHFT>;

            label = "M1";
        };

        m2: m2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M2";
        };

        m3: m3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M3";
        };

        m4: m4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp D>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M4";
        };

        m5: m5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RGUI &kp LCTRL>,
                <&macro_tap>,
                <&kp F4>,
                <&macro_release>,
                <&kp RGUI &kp LCTRL>;

            label = "M5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&kp TAB        &kp Q    &kp W         &kp E      &kp R  &kp T  &kp Y          &kp U      &kp I      &kp O         &kp P      &to 4
&kp BACKSPACE  &kp A    &kp S         &kp D      &kp F  &kp G  &kp H          &kp J      &kp K      &kp L         &kp SEMI   &kp ENTER
&sk LSHFT      &lt 7 Z  &kp X         &kp C      &kp V  &kp B  &kp N          &kp M      &kp COMMA  &kp PERIOD    &kp RCTRL  &sk RSHIFT
&mt RSHFT RET           &kp LEFT_ALT  &kp LCTRL  &mo 1  &td0   &kp RIGHT_GUI  &kp SPACE  &mo 2      &kp LEFT_ALT
            >;

            //sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;

            sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;
        };

        layer_1 {
            display-name = "layer_1";
            bindings = <
&kp ESC        &kp GRAVE        &kp TILDE     &kp PLUS       &kp EQUAL     &sk LC(LSHFT)     &sk LS(LALT)       &kp LESS_THAN   &kp GREATER_THAN   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_GUI
&kp BACKSPACE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH       &kp DOLLAR    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS       &kp SQT            &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ENTER
&kp LSHFT      &kp PERCENT      &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp QUESTION      &kp COLON          &kp UNDERSCORE  &kp DOUBLE_QUOTES  &kp PIPE              &kp SLASH              &kp NON_US_BACKSLASH
&mt RSHFT RET                   &kp LEFT_ALT  &kp LCTRL      &trans        &kp LCTRL         &kp RCTRL          &kp SPACE       &trans             &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;
        };

        layer_2 {
            display-name = "layer_2";
            bindings = <
&kp TAB        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_1  &kp J     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &to 8          &m1
&trans         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &mkp MB2  &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT        &kp RIGHT_GUI  &kp ENTER
&trans         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp M         &mkp MB1  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans         &mkp MB1
&mt RSHFT RET                &kp LEFT_ALT  &kp SPACE     &trans        &trans    &trans          &trans          &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;
        };

        layer_3 {
            bindings = <
&trans     &kp F1  &kp F2    &kp F3     &kp F10  &kp PAGE_UP  &kp PAGE_DOWN  &m2                     &m3                         &kp LS(DEL)            &kp RIGHT_GUI  &kp PRINTSCREEN
&trans     &kp F4  &kp F5    &kp F6     &kp F11  &kp HOME     &kp LS(HOME)   &kp LALT                &kp RCTRL                   &kp RGUI               &kp RALT       &kp ENTER
&kp LSHFT  &kp F7  &kp F8    &kp F9     &kp F12  &kp END      &kp LS(END)    &kp LG(LS(LEFT_ARROW))  &kp LC(LA(LG(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT)))  &kp DEL        &kp RSHFT
&trans             &kp LALT  &kp LCTRL  &trans   &trans       &trans         &m5                     &trans                      &m4
            >;

            label = "layer_3";
        };

        layer_4 {
            bindings = <
&to 0      &trans          &kp UP_ARROW    &kp F1     &kp F2     &kp F3     &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_7  &kp KP_NUMBER_0  &kp UP_ARROW  &to 5
&kp RCTRL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans     &kp END    &kp KP_NUMBER_1  &kp KP_NUMBER_4  &kp KP_NUMBER_7  &kp LEFT_ARROW   &kp DOWN      &kp RIGHT
&trans     &trans          &trans          &trans     &trans     &trans     &kp KP_NUMBER_1  &kp KP_NUMBER_1  &kp KP_NUMBER_7  &kp KP_NUMBER_9  &trans        &trans
&trans                     &kp LCTRL       &kp LCTRL  &kp RCTRL  &kp RCTRL  &kp RCTRL        &kp RCTRL        &kp KP_NUMBER_1  &kp KP_NUMBER_3
            >;

            label = "layer_4";
        };

        layer_5 {
            bindings = <
&to 0         &none  &kp ESCAPE  &none      &none      &none  &none  &kp RIGHT_SHIFT  &kp UP_ARROW  &none       &none      &to 6
&kp UP_ARROW  &kp M  &kp COMMA   &kp DOT    &kp FSLH   &none  &none  &kp M            &kp COMMA     &kp PERIOD  &kp SLASH  &kp UP_ARROW
&kp RSHFT     &kp Z  &kp X       &kp C      &kp V      &none  &none  &kp Z            &kp X         &kp C       &kp V      &kp RIGHT_SHIFT
&none                &kp SPACE   &kp SPACE  &kp SPACE  &none  &none  &kp SPACE        &kp SPACE     &none
            >;
        };

        layer_6 {
            bindings = <
&to 0  &none  &kp KP_NUMBER_7  &none            &kp F2           &none  &none  &none            &none            &kp KP_NUMBER_9  &none  &kp KP_NUMLOCK
&none  &none  &none            &kp KP_NUMBER_4  &none            &none  &none  &none            &kp KP_NUMBER_6  &none            &none  &kp KP_ENTER
&none  &none  &none            &kp KP_NUMBER_1  &kp KP_NUMBER_1  &none  &none  &kp KP_NUMBER_3  &kp KP_NUMBER_3  &none            &none  &none
&none         &none            &kp KP_NUMBER_5  &kp KP_NUMBER_0  &none  &none  &kp KP_NUMBER_0  &kp KP_NUMBER_5  &none
            >;
        };

        layer_7 {
            bindings = <
&to 0   &bt BT_SEL 0  &bt BT_SEL 1  &kp C_VOL_DN   &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK  &kp BACKSPACE
&trans  &none         &sk LCTRL     &sk RIGHT_ALT  &sk LEFT_SHIFT   &sk LEFT_GUI          &kp PLUS              &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &kp ENTER
&trans  &trans        &none         &none          &none            &kp ASTERISK          &kp MINUS             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp COMMA
&trans                &kp LEFT_ALT  &kp LCTRL      &kp LEFT_GUI     &kp LEFT_SHIFT        &kp MINUS             &kp SPACE     &kp SLASH     &kp PLUS
            >;
        };

        layer_8 {
            bindings = <
&kp TAB         &trans  &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans  &trans  &to 0
&mo 3           &trans  &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans  &trans  &kp END
&trans                  &trans  &kp SPACE  &mo 2   &kp RCTRL  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
