#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>

//#include <interfaces/hid-trackball.dtsi>  //zmk-hid-trackball-interface

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Main 0
#define Num 1
#define Mouse 2
#define Opt1 3
#define Opt2 4

//#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
//#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        select_to_bol {
            bindings = <&kp LS(HOME)>;
            key-positions = <30 31>;
            layers = <0>;
        };

        select_to_eol {
            bindings = <&kp RS(END)>;
            key-positions = <32 33>;
            layers = <0>;
        };

        word_backward {
            bindings = <&kp LC(LEFT)>;
            key-positions = <18 19>;
        };

        word_forward {
            bindings = <&kp RC(RIGHT)>;
            key-positions = <20 21>;
        };

        mousekey_3 {
            bindings = <&mkp MB3>;
            key-positions = <29 17>;
            layers = <2>;
        };
    };

    macros {
        m0: m0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "M0";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&kp TAB        &kp Q    &kp W         &kp E      &kp R  &kp T    &kp Y      &kp U  &kp I         &kp O       &kp P      &kp LBKT
&kp BACKSPACE  &kp A    &kp S         &kp D      &kp F  &kp G    &kp H      &kp J  &kp K         &kp L       &kp SEMI   &kp ENTER
&sk LSHFT      &lt 7 Z  &kp X         &kp C      &kp V  &kp B    &kp N      &kp M  &kp COMMA     &kp PERIOD  &kp RCTRL  &sk RSHIFT
&mt RSHFT RET           &kp LEFT_ALT  &kp LCTRL  &mo 1  &kp DEL  &kp SPACE  &mo 2  &kp LEFT_ALT  &kp RMETA
            >;

            //sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;

            sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;
        };

        layer_1 {
            display-name = "layer_1";
            bindings = <
&kp ESC        &kp GRAVE        &kp TILDE     &kp PLUS       &kp EQUAL     &sk LC(LS(T))     &sk LS(LA(Y))      &kp LESS_THAN   &kp GREATER_THAN   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_GUI
&kp BACKSPACE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH       &kp DOLLAR    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS       &kp SQT            &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ENTER
&kp LSHFT      &kp PERCENT      &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp QUESTION      &kp COLON          &kp UNDERSCORE  &kp DOUBLE_QUOTES  &kp PIPE              &kp SLASH              &kp NON_US_BACKSLASH
&mt RSHFT RET                   &kp LEFT_ALT  &kp LCTRL      &trans        &kp LCTRL         &kp SPACE          &trans          &kp RIGHT_ALT      &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;
        };

        layer_2 {
            display-name = "layer_2";
            bindings = <
&kp TAB        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_1  &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &m0            &kp LBKT
&trans         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0  &mkp MB2  &kp LEFT        &kp DOWN        &kp UP_ARROW    &kp RIGHT        &kp RIGHT_GUI  &kp ENTER
&trans         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp M         &mkp MB1  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans         &mkp MB1
&mt RSHFT RET                &kp LEFT_ALT  &kp SPACE     &trans        &trans    &trans          &trans          &msc SCRL_LEFT  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&inc_dec_kp A B>, <&inc_dec_kp A B>;
        };

        layer_3 {
            bindings = <
&trans     &kp F1  &kp F2    &kp F3     &kp F10  &kp PAGE_UP  &kp PAGE_DOWN  &trans                  &trans                      &kp LS(DEL)            &kp RIGHT_GUI  &kp PRINTSCREEN
&tog 3     &kp F4  &kp F5    &kp F6     &kp F11  &kp HOME     &kp LS(HOME)   &kp LALT                &kp RCTRL                   &kp RGUI               &kp RALT       &kp ENTER
&kp LSHFT  &kp F7  &kp F8    &kp F9     &kp F12  &kp END      &kp LS(END)    &kp LG(LS(LEFT_ARROW))  &kp LC(LA(LG(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT)))  &kp DEL        &kp RSHFT
&trans             &kp LALT  &kp LCTRL  &trans   &kp LCTRL    &trans         &trans                  &trans                      &trans
            >;

            label = "layer_3";
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "layer_4";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&to 0   &bt BT_SEL 1  &bt BT_SEL 2    &kp C_VOL_DN  &kp C_VOLUME_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &none         &kp LEFT_SHIFT  &trans        &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans          &trans        &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans                &trans          &trans        &trans           &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_11 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_12 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
